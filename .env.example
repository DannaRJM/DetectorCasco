# ─── Cámara Hikvision ──────────────────────────────────────────────────────────
CAM_HOST=192.168.110.76
CAM_PORT=80
CAM_USER=admin
CAM_PASS=tuPassword

# ─── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=token_de_tu_bot
TELEGRAM_CHAT_ID=id_del_chat

# ─── Detección ─────────────────────────────────────────────────────────────────
# Segundos entre cada captura de foto
CHECK_INTERVAL=10

# Confianza mínima del modelo para contar una detección (0.0 - 1.0)
CONF_THRESHOLD=0.50

# Segundos de cooldown entre alertas (300 = 5 min)
ALERT_COOLDOWN=300

# Nombre del área monitoreada (aparece en la alerta)
ZONA=Área de trabajo

# ─── Rutas ─────────────────────────────────────────────────────────────────────
MODELO_PATH=./modelo/best.pt
SNAP_DIR=C:/DetectorCasco/snapshots
